{
    https-port: 443
    email admin@mastersway.duckdns.org
}

trit-caddy-proxy.duckdns.org {
    header Access-Control-Allow-Origin "*"
    header Access-Control-Allow-Methods "GET, POST, OPTIONS"
    header Access-Control-Allow-Headers "Content-Type"

    @options {
        method OPTIONS
    }
    respond @options 204

    reverse_proxy http://localhost:13500
}