trit-caddy-proxy.duckdns.org:13500 {
    tls internal

    header Access-Control-Allow-Origin "*"
    header Access-Control-Allow-Methods "GET, POST, OPTIONS"
    header Access-Control-Allow-Headers "Content-Type"

    @options {
        method OPTIONS
    }
    respond @options 204

    @statusPaths {
        path /status /status.html
    }
    handle @statusPaths {
        root * /www
        @naked path /status
        rewrite @naked /status.html
        file_server
    }

    respond "Caddy proxy running on :13500 with HTTPS"
}